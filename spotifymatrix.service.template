# SpotifyMatrix systemd unit — versioned template.
#
# The live unit used to exist only on the Pi, edited in place by `sed` from
# matrix_control.ps1. That made the service configuration undocumented,
# unversioned, and unrecoverable if the SD card died. This file is the source
# of truth; the control script edits the installed copy, not this one.
#
# Install:
#   sed -e "s|@USER@|$USER|g" -e "s|@DIR@|$HOME/Documents/SpotifyMatrix|g" \
#       spotifymatrix.service.template | sudo tee /etc/systemd/system/spotifymatrix.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now spotifymatrix.service

[Unit]
Description=Spotify Matrix - album art on a 64x64 RGB LED panel
Documentation=https://github.com/Adi-Shinde/SpotifyMatrix
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@DIR@

# The panel is driven over GPIO, which needs root on this hardware.
User=root

# --gamma stays at 1.0 while the rgbmatrix build applies its own CIE1931
# curve; raise it to ~1.8 only if you measure that it does not.
ExecStart=@DIR@/.venv/bin/python3 spotify_matrix.py \
    --rows 64 --cols 64 --chain-length 1 --parallel 1 \
    --gpio-slowdown 5 --no-hardware-pulse \
    --hardware-mapping adafruit-hat-pwm \
    --pwm-bits 9 --limit-refresh-rate-hz 200 \
    --brightness 65

# SIGTERM is turned into a clean shutdown inside the process so the finally
# block runs display.clear(). Without this the panel keeps showing its last
# frame forever after `systemctl stop`.
KillSignal=SIGTERM
TimeoutStopSec=5

Restart=always
RestartSec=5

# Pin to the core reserved by isolcpus=3 in /boot/cmdline.txt. Reserving a
# core without pinning anything to it takes it away from the scheduler and
# gives it to nobody — these two settings only work as a pair.
# Verify with: taskset -cp $(pgrep -f spotify_matrix.py)
CPUAffinity=3

# Journal only; the SD card should not be filling up with our stdout.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
