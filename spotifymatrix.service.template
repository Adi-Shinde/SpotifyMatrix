# SpotifyMatrix systemd unit — versioned template.
#
# The live unit used to exist only on the Pi, edited in place by `sed` from
# matrix_control.ps1. That made the service configuration undocumented,
# unversioned, and unrecoverable if the SD card died. This file is the source
# of truth; the control script edits the installed copy, not this one.
#
# Install:
#   sed -e "s|@USER@|$USER|g" -e "s|@DIR@|$HOME/Documents/SpotifyMatrix|g" \
#       spotifymatrix.service.template | sudo tee /etc/systemd/system/spotifymatrix.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now spotifymatrix.service

[Unit]
Description=Spotify Matrix - album art on a 64x64 RGB LED panel
Documentation=https://github.com/Adi-Shinde/SpotifyMatrix
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@DIR@

# The panel is driven over GPIO, which needs root on this hardware.
User=root

# --gamma stays at 1.0 while the rgbmatrix build applies its own CIE1931
# curve; raise it to ~1.8 only if you measure that it does not.
# Saved web settings take precedence over service defaults on every boot.
ExecStart=@DIR@/.venv/bin/python3 spotify_matrix.py \
    --rows 64 --cols 64 --chain-length 1 --parallel 1 \
    --gpio-slowdown 5 --no-hardware-pulse \
    --hardware-mapping adafruit-hat-pwm \
    --pwm-bits 9 --limit-refresh-rate-hz 200 \
    --prefer-saved-settings

# SIGTERM is turned into a clean shutdown inside the process so the finally
# block runs display.clear(). Without this the panel keeps showing its last
# frame forever after `systemctl stop`.
KillSignal=SIGTERM
TimeoutStopSec=5

Restart=always
RestartSec=5

# Deliberately NO CPUAffinity= here. An earlier version pinned the service to
# CPUAffinity=3 to "use" the core reserved by isolcpus=3, on the assumption that
# nothing else claims it. That assumption is wrong: the library claims it
# itself. lib/gpio.cc Timers::Init() sets cpu3's governor to `performance` and
# runs its update thread there, and lib/thread.cc applies a
# pthread_setaffinity_np to the realtime thread.
#
# systemd's CPUAffinity= constrains EVERY thread in the process, so setting it
# dragged the Python renderer, the web server and the Spotify poller onto core 3
# alongside the SCHED_FIFO refresh thread that needs that core to itself. With
# sched_rt_runtime_us at 990000 the RT thread must yield 10ms every second, and
# with three starved threads queued behind it, that yield is when the panel
# visibly flickers.
#
# Keep isolcpus=3 in cmdline.txt — that is what reserves the core for the
# library to claim. Verify one FF 99 thread sits alone on psr=3 with:
#   ps -eLo pid,tid,cls,rtprio,psr,comm | grep python3

# Journal only; the SD card should not be filling up with our stdout.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
